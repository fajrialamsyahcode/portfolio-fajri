# ==============================================================================
# Portofolio Fajri Alamsyah — Environment Configuration Example
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk konfigurasi lingkungan lokal.
# JANGAN PERNAH memasukkan secret token atau kunci rahasia ke dalam repositori Git!
# ==============================================================================

# URL Situs Publik (untuk metadata SEO kanonikal & Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Konfigurasi Sanity CMS (Akan diisi pada Fase 3 setelah membuat proyek Sanity)
# Nilai ini adalah identitas proyek publik dan aman diekspos ke client:
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-24
